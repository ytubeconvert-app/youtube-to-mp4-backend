PORT=8787
HOST=0.0.0.0
NODE_ENV=production
ENFORCE_SIGNATURE=false
MAX_VIDEO_DURATION_SECONDS=7200
MAX_FILE_SIZE_MB=1500
FILE_EXPIRATION_MINUTES=15
CLEANUP_INTERVAL_MINUTES=5
TEMP_DIR=/app/temp_downloads
MAX_CONCURRENT_JOBS=4
# Optional: YouTube cookies to bypass cloud datacenter bot verification
# On Render: paste the raw text of cookies.txt into YT_COOKIES_CONTENT
# YT_COOKIES_CONTENT=
# YT_COOKIES_PATH=./cookies.txt

# Solution A: RapidAPI Cloud YouTube Downloader (100% bypass of cloud datacenter blocks on Render)
# Sign up free on RapidAPI and subscribe to "yt-api" or your preferred downloader
RAPIDAPI_KEY=
RAPIDAPI_HOST=yt-api.p.rapidapi.com

# Optional: Cloudflare Residential Tunnel URL (if running local PC bridge)
# RESIDENTIAL_TUNNEL_URL=

