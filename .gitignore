# Node dependencies
node_modules/

# Environment files (Keep .env secret, only track .env.example)
.env
.env.*
*.env
!.env.example

# Transcoded media files (Do NOT commit heavy video/audio downloads)
downloads/*
!downloads/.gitkeep
temp_downloads/*
!temp_downloads/.gitkeep

# Media binary executables (Do NOT commit to Git)
ffmpeg
ffmpeg.exe
ffprobe
ffprobe.exe
yt-dlp
yt-dlp.exe
*.exe
bin/

# Redundant subfolder
backend/

# Build outputs
dist/
build/
.astro/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor configurations
.vscode/
.idea/
*.sw?
*.sublime-project
*.sublime-workspace
