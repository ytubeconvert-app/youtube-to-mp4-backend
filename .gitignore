# =======================================================
# Dependencies
# =======================================================
node_modules/
.pnp
.pnp.js

# =======================================================
# Environment Variables & Secrets
# (Never commit real credentials; track .env.example)
# =======================================================
.env
.env.*
*.env
!.env.example
*cookies*.txt
cookies.txt

# =======================================================
# Media Binaries & Executables (yt-dlp, FFmpeg, etc.)
# (Heavy binaries >100MB rejected by GitHub/Bitbucket)
# =======================================================
bin/*
!bin/.gitkeep
ffmpeg
ffmpeg.exe
ffprobe
ffprobe.exe
yt-dlp
yt-dlp.exe
*.exe
*.gz
*.zip
*.tar
*.tar.gz

# =======================================================
# Transcoded & Ephemeral Media Files
# =======================================================
downloads/*
!downloads/.gitkeep
temp_downloads/*
!temp_downloads/.gitkeep
*.mp4
*.mp3
*.m4a
*.webm
*.part
*.ytdl

# =======================================================
# Build & TypeScript Compilation Outputs
# =======================================================
dist/
build/
*.tsbuildinfo

# =======================================================
# Logs & Diagnostic Dumps
# =======================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =======================================================
# OS Artifacts & Metadata
# =======================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# =======================================================
# IDE & Editor Configurations
# =======================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.sw?
